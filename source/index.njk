<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
  <title>オセロ</title>
  <link rel="stylesheet" href="/assets/style.css">
  <script src="/assets/gm.js" defer></script>
</head>
<body>
  <div class="container">
    <h1>オセロ</h1>

    <div class="info">
      <div class="score">
        <span class="black-score">黒: <strong id="blackCount">2</strong></span>
        <span class="white-score">白: <strong id="whiteCount">2</strong></span>
      </div>
      <div class="turn" id="turnDisplay">黒の番です</div>
    </div>

    <div id="board" class="board"></div>

    <div class="controls">
      <button id="restartBtn">最初から</button>
      <button id="passBtn" class="hidden">パス</button>
    </div>

    <div id="message" class="message"></div>
  </div>
</body>
</html>
